{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "{{HEADLINE}}",
  "description": "{{DESCRIPTION}}",
  "url": "{{PAGE_URL}}",
  "datePublished": "{{ISO_PUBLISHED_DATE}}",
  "dateModified": "{{ISO_MODIFIED_DATE}}",
  "image": ["{{IMAGE_URL}}"],
  "author": [
    {
      "@type": "Person",
      "name": "{{AUTHOR_NAME}}",
      "url": "{{AUTHOR_URL}}"
    }
  ],
  "publisher": {
    "@type": "Organization",
    "name": "{{SITE_NAME}}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{LOGO_URL}}"
    }
  }
}
