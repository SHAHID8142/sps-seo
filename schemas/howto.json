{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "{{HOWTO_TITLE}}",
  "description": "{{HOWTO_DESCRIPTION}}",
  "image": "{{IMAGE_URL}}",
  "totalTime": "PT{{MINUTES}}M",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "{{STEP_1_NAME}}",
      "text": "{{STEP_1_TEXT}}",
      "url": "{{STEP_1_URL}}"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "{{STEP_2_NAME}}",
      "text": "{{STEP_2_TEXT}}",
      "url": "{{STEP_2_URL}}"
    }
  ]
}
