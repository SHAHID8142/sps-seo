{
  "name": "sps-seo",
  "version": "1.5.0",
  "description": "Comprehensive, framework-agnostic AI agent skill and deterministic audit engine for technical SEO, on-page optimization, JSON-LD schema, performance, accessibility, security, and modern AI Search Optimization (GEO/AEO/AIO/SXO).",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "scripts/cli.mjs",
  "bin": {
    "sps-seo": "./scripts/cli.mjs"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:json": "node scripts/audit.mjs --json",
    "fix": "node scripts/fix.mjs --apply",
    "fix:dry": "node scripts/fix.mjs --dry-run",
    "links": "node scripts/internal-links.mjs",
    "cannibalization": "node scripts/cannibalization.mjs",
    "tfidf": "node scripts/tfidf.mjs",
    "keyword": "node scripts/keyword-audit.mjs",
    "snippet": "node scripts/snippet-audit.mjs",
    "redirect": "node scripts/redirect-audit.mjs",
    "backlink": "node scripts/backlink-audit.mjs",
    "competitor": "node scripts/competitor-intel.mjs",
    "compare": "node scripts/seo-compare.mjs",
    "perf": "node scripts/perf-budget.mjs",
    "bundle": "node scripts/bundle-audit.mjs",
    "a11y": "node scripts/a11y.mjs",
    "security": "node scripts/security-audit.mjs",
    "security:json": "node scripts/security-audit.mjs --json",
    "deps": "node scripts/dep-audit.mjs",
    "deps:json": "node scripts/dep-audit.mjs --json",
    "secrets": "node scripts/secrets-scan.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "ranking": "node scripts/ranking-intel.mjs",
    "rank-tracker": "node scripts/ranking-tracker.mjs",
    "preview": "node scripts/preview-serp.mjs",
    "validate-schema": "node scripts/validate-schema.mjs",
    "i18n": "node scripts/i18n-seo.mjs",
    "og": "node scripts/generate-og.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "sitemap:validate": "node scripts/sitemap-validate.mjs",
    "rss": "node scripts/generate-rss.mjs",
    "video": "node scripts/video-seo.mjs",
    "news": "node scripts/news-seo.mjs",
    "ecom": "node scripts/ecommerce-seo.mjs",
    "local": "node scripts/local-seo.mjs",
    "dup": "node scripts/duplicate-content.mjs",
    "crawl": "node scripts/crawler.mjs",
    "pagespeed": "node scripts/pagespeed.mjs",
    "gsc": "node scripts/gsc.mjs",
    "logs": "node scripts/log-analyzer.mjs",
    "monorepo": "node scripts/monorepo-detect.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "badge": "node scripts/badge.mjs",
    "sync-config": "node scripts/sync-config.mjs",
    "ping-indexnow": "node scripts/ping-indexnow.mjs",
    "install-skill": "./scripts/install.sh",
    "uninstall-skill": "./scripts/uninstall.sh",
    "update-skill": "./scripts/update.sh",
    "hook": "./scripts/setup-git-hook.sh",
    "consult": "node scripts/consultant.mjs",
    "test": "node tests/test-audit.mjs && node tests/test-phase2.mjs",
    "test:core": "node tests/test-audit.mjs",
    "test:phase2": "node tests/test-phase2.mjs"
  },
  "keywords": [
    "seo",
    "ai-seo",
    "aeo",
    "geo",
    "aio",
    "sxo",
    "lighthouse",
    "accessibility",
    "security",
    "tfidf",
    "snippet",
    "redirect",
    "backlink",
    "rank-tracking",
    "core-web-vitals",
    "schema-org",
    "json-ld",
    "llms-txt",
    "audit",
    "nextjs",
    "astro",
    "vite",
    "react",
    "sps"
  ],
  "author": "Shahid",
  "license": "MIT"
}
