{
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": "{{ARTICLE_URL}}/#article",
  "isPartOf": {
    "@type": "WebPage",
    "@id": "{{ARTICLE_URL}}"
  },
  "headline": "{{HEADLINE}}",
  "description": "{{DESCRIPTION}}",
  "image": [
    "{{IMAGE_URL}}"
  ],
  "datePublished": "{{DATE_PUBLISHED}}",
  "dateModified": "{{DATE_MODIFIED}}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ARTICLE_URL}}"
  },
  "author": {
    "@type": "Person",
    "name": "{{AUTHOR_NAME}}",
    "jobTitle": "{{AUTHOR_TITLE}}",
    "url": "{{AUTHOR_URL}}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{PUBLISHER_NAME}}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{PUBLISHER_LOGO_URL}}"
    }
  }
}
